--------------------------------------------------Audit--------------------------------------------------```python
from pyteal import *

tmpl_fee = Int(1000)
tmpl_rcv1 = Addr("6ZHGHH5Z5CTPCF5WCESXMGRSVK7QJETR63M3NY5FJCUYDHO57VTCMJOBGY")
tmpl_rcv2 = Addr("7Z5PWO2C6LFNQFGHWKSK5H47IQP5OJW2M3HA2QPXTY3WTNP5NU2MHBW27M")
tmpl_own = Addr("5MK5NGBRT5RL6IGUSYDIX5P7TNNZKRVXKT6FGVI6UVK6IZAWTYQGE4RZIQ")
tmpl_ratn = Int(1)
tmpl_ratd = Int(3)
tmpl_min_pay = Int(1000)
tmpl_timeout = Int(3000)


def split(
    tmpl_fee=tmpl_fee,
    tmpl_rcv1=tmpl_rcv1,
    tmpl_rcv2=tmpl_rcv2,
    tmpl_own=tmpl_own,
    tmpl_ratn=tmpl_ratn,
    tmpl_ratd=tmpl_ratd,
    tmpl_min_pay=tmpl_min_pay,
    tmpl_timeout=tmpl_timeout,
):
    
    split_core = And(
        Txn.type_enum() == TxnType.Payment,
        Txn.fee() <= tmpl_fee,  # Changed from < to <= for clarity
        Txn.rekey_to() == Global.zero_address(),  # ✅ Rekey check for current transaction
    )

    split_transfer = And(
        # Verify both transactions have same sender
        Gtxn[0].sender() == Gtxn[1].sender(),
        
        # Security checks for both transactions
        Gtxn[0].rekey_to() == Global.zero_address(),  # ✅ Rekey check for Gtxn[0]
        Gtxn[1].rekey_to() == Global.zero_address(),  # ✅ Rekey check for Gtxn[1]
        
        # Close remainder protection
        Txn.close_remainder_to() == Global.zero_address(),
        Gtxn[0].close_remainder_to() == Global.zero_address(),
        Gtxn[1].close_remainder_to() == Global.zero_address(),
        
        # Verify receivers
        Gtxn[0].receiver() == tmpl_rcv1,
        Gtxn[1].receiver() == tmpl_rcv2,
        
        # Amount calculations with proper integer division
        Gtxn[0].amount() == ((Gtxn[0].amount() + Gtxn[1].amount()) * tmpl_ratn) / tmpl_ratd,
        
        # Minimum payment check
        Gtxn[0].amount() >= tmpl_min_pay,  # Changed from == to >= for logical correctness
        Gtxn[1].amount() >= tmpl_min_pay,  # Added minimum for second payment
        
        # Fee checks for both transactions
        Gtxn[0].fee() <= tmpl_fee,
        Gtxn[1].fee() <= tmpl_fee,
        
        # Type checks for both transactions
        Gtxn[0].type_enum() == TxnType.Payment,
        Gtxn[1].type_enum() == TxnType.Payment,
    )

    split_close = And(
        Txn.close_remainder_to() == tmpl_own,
        Txn.receiver() == Global.zero_address(),
        Txn.amount() == Int(0),
        Txn.first_valid() > tmpl_timeout,
        Txn.rekey_to() == Global.zero_address(),  # ✅ Rekey check for closeout transaction
        Txn.fee() <= tmpl_fee,  # Added fee check for closeout
    )

    split_program = And(
        split_core, 
        If(Global.group_size() == Int(2), split_transfer, split_close)
    )

    return split_program


if __name__ == "__main__":
    print(compileTeal(split(), mode=Mode.Signature, version=6))
```

